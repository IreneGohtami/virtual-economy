  "_notes": {
    "margin_philosophy": "Margins are INVERSELY proportional to production speed. Fast/easy chains (Rice→Flour, Poultry→Meat) have thin margins (8-25%) to discourage camping on easy commodities. Slow/capital-heavy chains (Timber→Furniture, Nickel→Battery, Cattle→Beef) have fat margins (60-90%) to reward long-term investment and patience. L2 luxury goods (Mobile Phone, Automobile) have the highest absolute profit but require multi-chain coordination.",
    "incentive_structure": [
      "Early game: Farm Rice/Poultry for quick cash flow (low margin, high volume)",
      "Mid game: Invest in Cattle/Timber/Nickel for better per-unit margins (slow but rewarding)",
      "Late game: Coordinate multi-chain L2 assembly for highest ROI (Mobile Phone, Automobile)",
      "Strategic: Fertilizer and Battery are marketplace power items — producing them gives you leverage"
    ],
    "margin_tiers": {
      "fast_easy (8-25%)": ["flour", "cooking-oil", "chicken-meat", "gasoline", "roasted-coffee"],
      "medium (30-50%)": ["chocolate", "eggs", "biodiesel", "plastic", "fertilizer", "mobile-phone"],
      "slow_capital_heavy (60-90%)": ["beef", "milk", "steel", "battery", "furniture", "tire", "automobile"]
    },
    "city_terrain": "CITY is a new terrain type exclusively for shops. All shops require exactly 1 CITY tile. No factories can be placed on CITY terrain. This creates strategic land competition for shop placement.",
    "balance_flags": [
      "Milk gross/day (384) is very high due to fast 3h cycle + 16 price — may need demand-rate throttling at the shop level",
      "Beef margin (89%) is the highest L1 margin — justified by 16h Cattle L0 being the slowest livestock input",
      "Battery at 95 coins is the most expensive L1 unit — both L2 products depend on it, creating natural marketplace competition",
      "Chicken Meat margin (8%) is intentionally thin — it's the 'beginner trap' that works short-term but plateaus fast"
    ],
    "simulation_required": "Run Recipe Simulation Engine to validate: (1) Slow chains actually outperform fast chains over 30 days, (2) L2 break-even is achievable by day 10-15, (3) No single strategy dominates, (4) Marketplace creates healthy interdependence between specialties."
  }
